APP_NAME="Monitoring Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DISPLAY_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Log principal storage/logs/laravel-<date>.log, gardé 14 jours (SCRUM-61, RGPD-4)
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base Laravel (conteneur "mysql", port 3307 depuis le PC)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=monitoring
DB_USERNAME=monitoring
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (HTTPS) : voir .env.production.example
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Inscription (SCRUM-82) : invite (par défaut, pas d'inscription publique), domain (adresses de REGISTRATION_DOMAINS)
# ou open (démo publique). Le compte est toujours créé sans team.
REGISTRATION_MODE=invite
REGISTRATION_DOMAINS=
# Contact affiché sur la page « Waiting for access » (facultatif)
REGISTRATION_CONTACT=

# Webhooks (SCRUM-75) : hôtes de démo acceptés en HTTP et sur le réseau interne (sinon HTTPS et adresse publique)
WEBHOOK_ALLOWED_HOSTS=fake-api

# 2FA obligatoire pour les Super Admin et les Admin de team (SCRUM-86)
TWO_FACTOR_FOR_ADMINS=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@monitoring-platform.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Zabbix : API vue depuis le conteneur "app"
# Token : Zabbix > Users > API tokens > Create API token (voir README)
ZABBIX_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_TIMEOUT=15
ZABBIX_RETRIES=2
ZABBIX_RETRY_DELAY=200
# Compte utilisé par la datasource Grafana
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
# Base de Zabbix
ZBX_DB_PASSWORD=zabbix_pwd
ZBX_DB_ROOT_PASSWORD=zabbix_root_pwd
# Agent Zabbix 2 (SCRUM-67) : adresse vue depuis zabbix-server, interface agent par défaut des hosts
ZABBIX_AGENT_HOST=zabbix-agent2
ZABBIX_AGENT_PORT=10050
# Template Zabbix lié aux targets de type serveur (SCRUM-69)
ZABBIX_SERVER_TEMPLATE="Linux by Zabbix agent"
# Utilisateur MySQL en lecture seule de l'agent Zabbix 2 (zbx_monitor, SCRUM-67)
ZBX_MONITOR_DB_PASSWORD=zbx_monitor_pwd

# Grafana : URL vue depuis le navigateur
# Grafana derrière la plateforme (SCRUM-48) : les utilisateurs passent par /grafana/ (auth proxy de nginx)
GRAFANA_URL=http://localhost:8000/grafana
# Grafana vu depuis le conteneur de l'application : état (SCRUM-47) et API d'administration (SCRUM-48)
GRAFANA_INTERNAL_URL=http://grafana:3000/grafana
# Compte admin de Grafana : utilisé côté serveur seulement, jamais montré aux utilisateurs
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Hôtes internes autorisés comme URL de target malgré la protection SSRF (SCRUM-57) : démo uniquement
TARGET_ALLOWED_INTERNAL_HOSTS=fake-api,demo-website-01

# Environnement de démonstration (SCRUM-73, docs/demo/README.md) : docker compose --profile demo up -d
# puis php artisan db:seed --class=DemoSeeder. Mot de passe vide : un mot de passe aléatoire est affiché par le seeder.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
DEMO_MYSQL_MONITOR_PASSWORD=demo_monitor_pwd

# SSO de démo (SCRUM-91) : Keycloak, docker compose --profile sso up -d keycloak (http://localhost:8180).
# Vides : générés au premier démarrage de Keycloak et gardés dans son volume ; les lire avec
# docker compose exec keycloak cat /opt/keycloak/data/demo/secrets.env
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DEMO_CLIENT_SECRET=
KEYCLOAK_DEMO_USER_PASSWORD=

# Sauvegarde des bases Laravel et Zabbix (SCRUM-62) : php artisan backup:run, chaque nuit à BACKUP_TIME (UTC)
BACKUP_RETENTION_DAYS=7
BACKUP_TIME=02:30

# Journal d'audit conservé 365 jours, purgé chaque nuit (SCRUM-60)
AUDIT_RETENTION_DAYS=365
# BACKUP_PATH=/var/www/html/storage/app/backups

# En-têtes de sécurité (SCRUM-61) : HSTS envoyé seulement en HTTPS hors localhost ; 0 = désactivé
SECURITY_HSTS_MAX_AGE=31536000
