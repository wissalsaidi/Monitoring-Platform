# Configuration de production (SCRUM-61) : copier en .env sur le serveur et remplir les valeurs <...>
# Puis : php artisan security:check  (doit afficher OK partout). Procédure : docs/exploitation/production.md
# Seules les différences avec .env.example sont listées ; reprendre .env.example pour le reste (Zabbix, sauvegardes…).

APP_NAME="Monitoring Platform"
APP_ENV=production
# Clé propre à la production : php artisan key:generate --show
APP_KEY=
# Jamais true : la page d'erreur afficherait le code et les secrets
APP_DEBUG=false
APP_URL=https://<domaine>

# storage/logs/laravel-<date>.log, gardé 14 jours (RGPD-4)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Mots de passe longs et aléatoires, différents de ceux du développement
DB_PASSWORD=<secret>
DB_ROOT_PASSWORD=<secret>
ZBX_DB_PASSWORD=<secret>
ZBX_DB_ROOT_PASSWORD=<secret>
GRAFANA_ADMIN_PASSWORD=<secret>

# Cookie de session chiffré et envoyé uniquement en HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# HSTS : 300 le premier jour, puis un an (31536000) une fois HTTPS validé
SECURITY_HSTS_MAX_AGE=31536000

# Vrai serveur SMTP (pas Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<smtp.fournisseur>
MAIL_PORT=465
MAIL_USERNAME=<utilisateur>
MAIL_PASSWORD=<secret>
MAIL_FROM_ADDRESS="noreply@<domaine>"
